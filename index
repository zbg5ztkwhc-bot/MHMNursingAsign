      <div class="home-footnote">Firebase project: mhmnursing-4375d · Assignment timezone: Asia/Riyadh</div>
    </div>
  </main>

  <main id="viewScreen" class="inner-screen" hidden>
    <div class="page-wrap board-wide">
      <div class="cloud-panel board-cloud-panel"><div><div class="section-kicker">Cloud Firestore · live updates</div><strong id="viewStatusText">Connecting…</strong><div class="hint">Assignment dates are shown newest first.</div></div><div class="view-toolbar-actions"><label class="date-picker-label inline-select">Assignment history<select id="viewDateSelect"></select></label><button id="viewEditBtn" class="btn btn-ghost" type="button">Edit selected date</button></div></div>
      <div class="meta-row board-meta"><div class="meta-field"><label>Unit / Ward</label><input id="viewUnitName" type="text" readonly></div><div class="meta-field"><label>Date</label><input id="viewDateField" type="text" readonly></div><div class="meta-updated" id="viewUpdatedNote">Waiting for data…</div></div>
      <section class="staffing-overview"><div class="overview-head"><div><div class="section-kicker">Visible at every nurse station</div><h2>Station Staffing Overview</h2></div><div class="overview-note">Who is assigned to each station</div></div><div class="station-overview-grid" id="stationOverviewGrid"></div></section>
      <section class="station-display-control"><div><div class="section-kicker">This screen</div><h2 id="selectedStationHeading">Station 1 Assignment</h2></div><div class="station-screen-tabs" id="viewStationTabs"></div></section>
      <div id="viewEmptyState" class="empty-cloud-state" style="display:none"><strong>No assignment saved for this date.</strong><span>A supervisor can create it from Edit Assignment.</span></div>
      <div class="shift-columns station-detail-columns" id="viewStationDetails"><div class="shift-panel"><div class="shift-head day"><h3>Day Shift</h3><span class="hours" id="viewDayCount">— slots</span></div><div class="shift-grid" id="viewDayGrid"></div></div><div class="shift-panel"><div class="shift-head night"><h3>Night Shift</h3><span class="hours" id="viewNightCount">— slots</span></div><div class="shift-grid" id="viewNightGrid"></div></div></div>
    </div>
  </main>

  <main id="editScreen" class="inner-screen" hidden>
    <div class="page-wrap">
      <div class="cloud-panel"><div><div class="section-kicker">Cloud Firestore</div><strong id="cloudStatus">Loading assignment…</strong><div class="hint" id="cloudDetail">Changes save automatically after you stop typing.</div></div><div class="cloud-actions"><label class="date-picker-label">Assignment date<input type="date" id="editDateField"></label><button class="btn btn-primary" id="saveBtn" type="button">Save now</button></div></div>
      <div id="lockedBanner" class="support-banner locked-banner" style="display:none"><strong>Past assignment locked.</strong> This date has finished in Asia/Riyadh and cannot be modified.</div>
      <fieldset id="editorArea" style="border:none;padding:0;margin:0;"><div class="meta-row"><div class="meta-field"><label for="editUnitName">Unit / Ward</label><input type="text" id="editUnitName" placeholder="e.g. ICU"></div><div class="meta-updated" id="editUpdatedNote">Not saved yet</div></div>
        <section class="station-editor-shell"><div class="section-kicker">Choose station to edit</div><div class="station-tabs" id="editStationTabs"></div><div class="station-name-row"><div class="meta-field station-name-field"><label for="stationName">Station display name</label><input type="text" id="stationName" placeholder="Station 1"></div><div class="station-help">Each staff member can have <strong>multiple unit assignments</strong>. The list closes when you click outside it.</div></div></section>
        <div class="shift-columns"><div class="shift-panel"><div class="shift-head day"><h3><span id="editDayStationTitle">Station 1</span> · Day Shift</h3><span class="hours" id="editDayCount">12 slots</span></div><table class="assign-table"><thead><tr><th class="col-idx">#</th><th class="col-nurse">Staff</th><th class="col-patient">Patient Assignment</th><th class="col-unit">Unit Assignments</th><th class="col-action"></th></tr></thead><tbody id="editDayBody"></tbody></table><div class="shift-foot"><button type="button" class="add-slot-btn" id="dayAddBtn">+ Add slot</button></div></div>
        <div class="shift-panel"><div class="shift-head night"><h3><span id="editNightStationTitle">Station 1</span> · Night Shift</h3><span class="hours" id="editNightCount">12 slots</span></div><table class="assign-table"><thead><tr><th class="col-idx">#</th><th class="col-nurse">Staff</th><th class="col-patient">Patient Assignment</th><th class="col-unit">Unit Assignments</th><th class="col-action"></th></tr></thead><tbody id="editNightBody"></tbody></table><div class="shift-foot"><button type="button" class="add-slot-btn" id="nightAddBtn">+ Add slot</button></div></div></div>
      </fieldset>
      <div class="actions-row"><button class="btn btn-ghost" id="previewBtn" type="button">Preview selected date</button><button class="btn btn-primary" id="saveBottomBtn" type="button">Save now</button></div><div class="legend-note">Documents are stored in <strong>assignments/YYYY-MM-DD</strong>. Security rules—not only the interface—prevent writes to past dates.</div>
    </div><div class="save-toast" id="toast">Saved to Firestore.</div>
  </main>

  <main id="adminScreen" class="inner-screen" hidden>
    <div class="page-wrap admin-wrap"><section class="admin-hero"><div><div class="section-kicker">Administrator only</div><h2>Registered users and roles</h2><p>New registrations start as Staff. Promote a user to Supervisor to allow editing today and future assignments.</p></div><button id="refreshUsersBtn" class="btn btn-ghost">Refresh</button></section><div id="adminMessage" class="auth-message" aria-live="polite"></div><div class="users-table-wrap"><table class="users-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Updated</th></tr></thead><tbody id="usersBody"></tbody></table></div></div>
  </main>
</div>

<script type="module">
import { initializeApp } from 'https://www.gstatic.com/firebasejs/12.18.0/firebase-app.js';
import { getAuth, onAuthStateChanged, signInWithEmailAndPassword, createUserWithEmailAndPassword, signOut, updateProfile } from 'https://www.gstatic.com/firebasejs/12.18.0/firebase-auth.js';
import { getFirestore, collection, doc, getDoc, getDocs, setDoc, updateDoc, onSnapshot, query, orderBy, serverTimestamp, runTransaction } from 'https://www.gstatic.com/firebasejs/12.18.0/firebase-firestore.js';

const firebaseConfig = {
  apiKey: 'AIzaSyCqUiYN9ce6afuDYvltijbOnb9d4uNSi-Y',
  authDomain: 'mhmnursing-4375d.firebaseapp.com',
  projectId: 'mhmnursing-4375d',
  storageBucket: 'mhmnursing-4375d.firebasestorage.app',
  messagingSenderId: '1920599544',
  appId: '1:1920599544:web:511c97c4a584227c86c20d',
  measurementId: 'G-S3VWMZ5QT3'
};
const APP_CONFIG = { administratorEmail:'mahmod.hamoda@gmail.com', administratorName:'Mahmoud Hamouda', assignmentTimeZone:'Asia/Riyadh', autoSaveDelayMs:1800 };
const app = initializeApp(firebaseConfig);
const auth = getAuth(app);
const db = getFirestore(app);

const UNIT_OPTIONS = [
  {id:'1',label:'Narcotic',icon:'💊',color:'#7c3fae'},
  {id:'2',label:'Floor Stock & High-Alert Medication',icon:'🧴',color:'#c97a2b'},
  {id:'3',label:'Crash Cart',icon:'🚑',color:'#b3452f'},
  {id:'4',label:'Intubation Kit',icon:'🫁',color:'#1f8a82'},
  {id:'5',label:'IV Trolley',icon:'💉',color:'#146b8c'},
  {id:'6',label:'Cleaning Schedule',icon:'🧹',color:'#0d3b3e'},
  {id:'7',label:'Central Monitor',icon:'📈',color:'#10262b'},
  {id:'8',label:'Dressing Trolley',icon:'🩹',color:'#8a5b3f'},
  {id:'9',label:'Cleaning Medication',icon:'🧼',color:'#557a65'},
  {id:'10',label:'Oxygen Cylinder',icon:'🫧',color:'#3f7796'},
  {id:'11',label:'Ref Medication & Oral Syrup',icon:'💊',color:'#8b5a88'},
  {id:'12',label:'POCT',icon:'🧪',color:'#567088'},
  {id:'13',label:'Equipment',icon:'🩺',color:'#526b60'},
  {id:'14',label:'Station Arrangement',icon:'🏥',color:'#5e6874'}
];
const STATION_COUNT=4, DEFAULT_SLOTS=12;
const unitById=id=>UNIT_OPTIONS.find(u=>u.id===String(id))||null;
const blankAssignment=()=>({nurse:'',patient:'',units:[]});
const blankShift=(count=DEFAULT_SLOTS)=>Array.from({length:count},blankAssignment);
const blankStation=i=>({id:`station-${i}`,name:`Station ${i}`,shifts:{day:blankShift(),night:blankShift()}});
function defaultAssignmentData(dateId=''){return{schemaVersion:4,unitName:'',date:dateId,assignmentDate:dateId,updatedAt:null,updatedBy:null,revision:0,stations:Array.from({length:STATION_COUNT},(_,i)=>blankStation(i+1))};}
function normalizeUnits(cell){const valid=new Set(UNIT_OPTIONS.map(u=>u.id));let ids=[];if(Array.isArray(cell?.units))ids=cell.units;else if(cell?.unit)ids=[cell.unit];return[...new Set(ids.map(String).filter(id=>valid.has(id)))];}
function normalizeCell(cell={}){return{nurse:typeof cell.nurse==='string'?cell.nurse:'',patient:typeof cell.patient==='string'?cell.patient:'',units:normalizeUnits(cell)};}
function normalizeShift(value){return Array.isArray(value)&&value.length?value.map(normalizeCell):[blankAssignment()];}
function normalizeStation(station,index){station=station||{};const shifts=station.shifts||{};return{id:`station-${index}`,name:typeof station.name==='string'&&station.name.trim()?station.name.trim():`Station ${index}`,shifts:{day:normalizeShift(shifts.day),night:normalizeShift(shifts.night)}};}
function normalizeAssignmentData(raw,fallbackDate=''){const result=defaultAssignmentData(fallbackDate);raw=raw||{};result.unitName=typeof raw.unitName==='string'?raw.unitName:'';result.assignmentDate=typeof raw.assignmentDate==='string'?raw.assignmentDate:(typeof raw.date==='string'?raw.date:fallbackDate);result.date=result.assignmentDate;result.updatedAt=raw.updatedAt||null;result.updatedBy=raw.updatedBy||null;result.revision=Number.isInteger(raw.revision)?raw.revision:0;if(Array.isArray(raw.stations))result.stations=Array.from({length:STATION_COUNT},(_,i)=>normalizeStation(raw.stations[i],i+1));else if(raw.shifts)result.stations[0]=normalizeStation({name:'Station 1',shifts:raw.shifts},1);return result;}
function stationStaff(station,shiftName){const rows=station?.shifts?.[shiftName]||[],seen=new Set(),names=[];rows.forEach(row=>{const name=(row.nurse||'').trim(),key=name.toLocaleLowerCase();if(name&&!seen.has(key)){seen.add(key);names.push(name);}});return names;}
function todayDateId(){const parts=new Intl.DateTimeFormat('en-CA',{timeZone:APP_CONFIG.assignmentTimeZone,year:'numeric',month:'2-digit',day:'2-digit'}).formatToParts(new Date());const m=Object.fromEntries(parts.filter(p=>p.type!=='literal').map(p=>[p.type,p.value]));return`${m.year}-${m.month}-${m.day}`;}
const isPastDate=id=>!!id&&id<todayDateId();
function formatTimestamp(value){if(!value)return'';const d=typeof value.toDate==='function'?value.toDate():new Date(value);if(Number.isNaN(d.getTime()))return'';return new Intl.DateTimeFormat(undefined,{dateStyle:'medium',timeStyle:'short',timeZone:APP_CONFIG.assignmentTimeZone}).format(d);}
const isAdminEmail=email=>String(email||'').trim().toLowerCase()===APP_CONFIG.administratorEmail;
async function ensureUserProfile(user,requestedName=''){const ref=doc(db,'users',user.uid),snap=await getDoc(ref);if(snap.exists()){const p=snap.data();return isAdminEmail(user.email)?{...p,role:'admin'}:p;}const admin=isAdminEmail(user.email);const profile={name:(admin?APP_CONFIG.administratorName:requestedName||user.displayName||user.email||'User').trim(),email:String(user.email||'').toLowerCase(),role:admin?'admin':'staff',createdAt:serverTimestamp(),updatedAt:serverTimestamp()};await setDoc(ref,profile);return{...profile,createdAt:null,updatedAt:null};}

let session=null,currentSection='home',viewUnsub=null,selectedViewDate=todayDateId(),selectedStationIndex=Math.min(3,Math.max(0,parseInt(localStorage.getItem('nab-view-station')||'1',10)-1||0));
let editData=defaultAssignmentData(),loadedEditDate=todayDateId(),activeEditStation=0,dirty=false,saving=false,saveTimer=null;

const $=id=>document.getElementById(id);
function setAuthMessage(text,error=false){$('authMessage').textContent=text;$('authMessage').style.color=error?'#b3452f':'';}
function showAuthTab(which){const login=which==='login';$('loginForm').hidden=!login;$('registerForm').hidden=login;$('loginTabBtn').className=login?'btn btn-primary':'btn btn-ghost';$('registerTabBtn').className=login?'btn btn-ghost':'btn btn-primary';setAuthMessage('');}
$('loginTabBtn').addEventListener('click',()=>showAuthTab('login'));$('registerTabBtn').addEventListener('click',()=>showAuthTab('register'));
$('loginForm').addEventListener('submit',async e=>{e.preventDefault();setAuthMessage('Signing in…');try{await signInWithEmailAndPassword(auth,$('loginEmail').value.trim(),$('loginPassword').value);}catch(err){console.error(err);setAuthMessage(err.code==='auth/invalid-credential'?'Email or password is incorrect.':`Could not sign in: ${err.message}`,true);}});
$('registerForm').addEventListener('submit',async e=>{e.preventDefault();const name=$('registerName').value.trim(),email=$('registerEmail').value.trim(),pw=$('registerPassword').value;if(pw!==$('registerConfirm').value){setAuthMessage('Passwords do not match.',true);return;}setAuthMessage('Creating account…');try{const cred=await createUserWithEmailAndPassword(auth,email,pw);await updateProfile(cred.user,{displayName:name});await ensureUserProfile(cred.user,name);}catch(err){console.error(err);setAuthMessage(err.code==='auth/email-already-in-use'?'That email is already registered.':`Could not register: ${err.message}`,true);}});
$('logoutBtn').addEventListener('click',()=>signOut(auth));

document.querySelectorAll('[data-go]').forEach(btn=>btn.addEventListener('click',()=>navigate(btn.dataset.go)));
document.querySelectorAll('.station-jump').forEach(btn=>btn.addEventListener('click',()=>{selectedStationIndex=Number(btn.dataset.station)-1;localStorage.setItem('nab-view-station',String(selectedStationIndex+1));navigate('view');}));

function applyRoleUI(){const role=session?.profile?.role||'staff',canEdit=['supervisor','admin'].includes(role),admin=role==='admin';$('navEdit').hidden=!canEdit;$('homeEdit').hidden=!canEdit;$('viewEditBtn').hidden=!canEdit;$('navAdmin').hidden=!admin;$('homeAdmin').hidden=!admin;$('topUser').textContent=session?.profile?.name||session?.user?.email||'';$('topRole').textContent=role;}
function hideInnerScreens(){['homeScreen','viewScreen','editScreen','adminScreen'].forEach(id=>$(id).hidden=true);}
async function navigate(target){if(!session)return;const role=session.profile.role;if(target==='edit'&&!['supervisor','admin'].includes(role))target='view';if(target==='admin'&&role!=='admin')target='home';hideInnerScreens();currentSection=target;const map={home:'homeScreen',view:'viewScreen',edit:'editScreen',admin:'adminScreen'};$(map[target]).hidden=false;$('topTitle').textContent={home:'Nursing Assignment Board',view:'Assignment Board',edit:'4-Station Assignment Editor',admin:'User Administration'}[target];if(target==='view')await initView();if(target==='edit')await initEdit();if(target==='admin')await loadUsers();window.scrollTo({top:0,behavior:'instant'});}

async function getAssignment(dateId){const snap=await getDoc(doc(db,'assignments',dateId));return snap.exists()?normalizeAssignmentData(snap.data(),dateId):null;}
async function listAssignmentDates(){const snap=await getDocs(query(collection(db,'assignments'),orderBy('assignmentDate','desc')));return snap.docs.map(d=>({id:d.id,...d.data()}));}
function subscribeAssignment(dateId,onData,onError){return onSnapshot(doc(db,'assignments',dateId),snap=>onData(snap.exists()?normalizeAssignmentData(snap.data(),dateId):null),onError);}
async function saveAssignment(data){const dateId=data.assignmentDate||data.date;if(!/^\d{4}-\d{2}-\d{2}$/.test(dateId))throw new Error('Choose a valid assignment date.');if(isPastDate(dateId))throw new Error('Past assignments are locked and cannot be modified.');const ref=doc(db,'assignments',dateId),normalized=normalizeAssignmentData(data,dateId),expected=Number.isInteger(normalized.revision)?normalized.revision:0;let newRevision=0;await runTransaction(db,async tx=>{const existing=await tx.get(ref);if(existing.exists()){const current=Number.isInteger(existing.data().revision)?existing.data().revision:0;if(current!==expected)throw new Error('Another supervisor saved a newer version. Reload this date before saving so their changes are not overwritten.');newRevision=current+1;}else{if(expected!==0)throw new Error('The assignment changed in Firestore. Reload before saving.');newRevision=1;}tx.set(ref,{...normalized,date:dateId,assignmentDate:dateId,revision:newRevision,updatedAt:serverTimestamp(),updatedBy:{uid:session.user.uid,name:session.profile.name||session.user.displayName||session.user.email||'',email:session.user.email||''}});});return newRevision;}

// VIEW
function renderStaffList(container,names){container.innerHTML='';if(!names.length){const e=document.createElement('span');e.className='staff-empty';e.textContent='No staff assigned';container.appendChild(e);return;}names.forEach(name=>{const c=document.createElement('span');c.className='staff-chip';c.textContent=name;container.appendChild(c);});}
function renderOverview(data){const grid=$('stationOverviewGrid');grid.innerHTML='';data.stations.forEach((station,i)=>{const card=document.createElement('article');card.className='station-overview-card'+(i===selectedStationIndex?' current':'');const head=document.createElement('div');head.className='station-overview-card-head';const num=document.createElement('span');num.className='station-number';num.textContent=String(i+1);const name=document.createElement('h3');name.textContent=station.name;head.append(num,name);const day=document.createElement('div');day.className='staff-shift-row';const dl=document.createElement('b');dl.textContent='Day';const dn=document.createElement('div');dn.className='staff-chips';renderStaffList(dn,stationStaff(station,'day'));day.append(dl,dn);const night=document.createElement('div');night.className='staff-shift-row';const nl=document.createElement('b');nl.textContent='Night';const nn=document.createElement('div');nn.className='staff-chips';renderStaffList(nn,stationStaff(station,'night'));night.append(nl,nn);card.append(head,day,night);grid.appendChild(card);});}
function renderViewStationTabs(data){const tabs=$('viewStationTabs');tabs.innerHTML='';data.stations.forEach((station,i)=>{const b=document.createElement('button');b.type='button';b.className='station-screen-tab'+(i===selectedStationIndex?' active':'');b.textContent=station.name;b.addEventListener('click',()=>{selectedStationIndex=i;localStorage.setItem('nab-view-station',String(i+1));renderView(data);});tabs.appendChild(b);});}
function renderGrid(container,cells){container.innerHTML='';cells.forEach((c,i)=>{const units=(c.units||[]).map(unitById).filter(Boolean),primary=units[0]||null,has=!!(c.nurse||c.patient||units.length);const card=document.createElement('div');card.className='assign-card'+(has?'':' unassigned');if(primary)card.style.background=`linear-gradient(160deg, ${primary.color}, ${primary.color}cc)`;const icon=document.createElement('div');icon.className='card-icon';icon.textContent=primary?primary.icon:'＋';const slot=document.createElement('div');slot.className='card-slot';slot.textContent=`#${i+1}`;const nurse=document.createElement('div');nurse.className='card-nurse';nurse.textContent=c.nurse||'No staff assigned';card.append(icon,slot,nurse);if(c.patient){const p=document.createElement('div');p.className='card-patient';p.textContent=c.patient;card.appendChild(p);}if(units.length){const duties=document.createElement('div');duties.className='card-units';units.forEach(u=>{const badge=document.createElement('span');badge.className='card-unit-badge';badge.textContent=`${u.icon} ${u.label}`;duties.appendChild(badge);});card.appendChild(duties);}else{const u=document.createElement('div');u.className='card-unit card-unit-empty';u.textContent='No unit duties';card.appendChild(u);}container.appendChild(card);});}
let currentViewData=defaultAssignmentData();
function renderView(data){currentViewData=normalizeAssignmentData(data,selectedViewDate);const station=currentViewData.stations[selectedStationIndex]||currentViewData.stations[0];$('viewUnitName').value=currentViewData.unitName||'';$('viewDateField').value=currentViewData.assignmentDate||selectedViewDate;$('selectedStationHeading').textContent=`${station.name} Assignment`;renderViewStationTabs(currentViewData);renderOverview(currentViewData);renderGrid($('viewDayGrid'),station.shifts.day);renderGrid($('viewNightGrid'),station.shifts.night);$('viewDayCount').textContent=`${station.shifts.day.length} slot${station.shifts.day.length===1?'':'s'}`;$('viewNightCount').textContent=`${station.shifts.night.length} slot${station.shifts.night.length===1?'':'s'}`;const by=currentViewData.updatedBy?.name?` by ${currentViewData.updatedBy.name}`:'';$('viewUpdatedNote').textContent=currentViewData.updatedAt?`Last updated ${formatTimestamp(currentViewData.updatedAt)}${by}`:'No saved update';$('viewEditBtn').disabled=isPastDate(selectedViewDate);$('viewEditBtn').textContent=isPastDate(selectedViewDate)?'Past date locked':'Edit selected date';}
function subscribeView(dateId){if(viewUnsub)viewUnsub();selectedViewDate=dateId;$('viewStatusText').textContent='Connecting…';viewUnsub=subscribeAssignment(dateId,data=>{$('viewStatusText').textContent='Live · Firestore';const empty=!data;$('viewEmptyState').style.display=empty?'flex':'none';$('viewStationDetails').style.display=empty?'none':'';renderView(data||defaultAssignmentData(dateId));},err=>{console.error(err);$('viewStatusText').textContent=`Firestore problem: ${err.message}`;});}
async function initView(){try{const rows=await listAssignmentDates(),ids=[...new Set(rows.map(r=>r.assignmentDate||r.id).filter(Boolean))];if(!ids.includes(selectedViewDate))ids.push(selectedViewDate);ids.sort().reverse();const sel=$('viewDateSelect');sel.innerHTML='';ids.forEach(id=>{const o=document.createElement('option');o.value=id;o.textContent=id+(id===todayDateId()?' · Today':'');o.selected=id===selectedViewDate;sel.appendChild(o);});subscribeView(selectedViewDate);}catch(err){console.error(err);$('viewStatusText').textContent=`Could not load dates: ${err.message}`;}}
$('viewDateSelect').addEventListener('change',()=>subscribeView($('viewDateSelect').value));$('viewEditBtn').addEventListener('click',()=>{if(!isPastDate(selectedViewDate)){loadedEditDate=selectedViewDate;navigate('edit');}});

// EDIT
function selectedSummary(units){if(!units?.length)return'— Select duties —';if(units.length===1)return unitById(units[0])?.label||'1 duty selected';return`${units.length} duties selected`;}
function buildUnitPicker(cell){const details=document.createElement('details');details.className='unit-picker';const summary=document.createElement('summary');summary.textContent=selectedSummary(cell.units);details.appendChild(summary);const menu=document.createElement('div');menu.className='unit-picker-menu';UNIT_OPTIONS.forEach(u=>{const label=document.createElement('label'),check=document.createElement('input'),text=document.createElement('span');check.type='checkbox';check.checked=cell.units.includes(u.id);check.addEventListener('change',()=>{if(check.checked){if(!cell.units.includes(u.id))cell.units.push(u.id);}else cell.units=cell.units.filter(id=>id!==u.id);summary.textContent=selectedSummary(cell.units);markDirty();});text.className='unit-option-text';text.textContent=`${u.icon} ${u.label}`;label.append(check,text);menu.appendChild(label);});details.appendChild(menu);return details;}
document.addEventListener('click',e=>document.querySelectorAll('details.unit-picker[open]').forEach(p=>{if(!p.contains(e.target))p.open=false;}));document.addEventListener('keydown',e=>{if(e.key==='Escape')document.querySelectorAll('details.unit-picker[open]').forEach(p=>p.open=false);});
function renderShiftTable(state,tbody,countEl){tbody.innerHTML='';state.forEach((cell,i)=>{const tr=document.createElement('tr');const nurse=document.createElement('input');nurse.type='text';nurse.placeholder='Staff name';nurse.value=cell.nurse||'';nurse.addEventListener('input',()=>{state[i].nurse=nurse.value;markDirty();});const patient=document.createElement('input');patient.type='text';patient.placeholder='Patient / room';patient.value=cell.patient||'';patient.addEventListener('input',()=>{state[i].patient=patient.value;markDirty();});const idx=document.createElement('td');idx.className='idx';idx.textContent=i+1;const nt=document.createElement('td');nt.appendChild(nurse);const pt=document.createElement('td');pt.appendChild(patient);const ut=document.createElement('td');ut.appendChild(buildUnitPicker(cell));const at=document.createElement('td');at.className='action-cell';const rm=document.createElement('button');rm.type='button';rm.className='row-remove-btn';rm.textContent='×';rm.title='Remove this slot';rm.disabled=state.length<=1;rm.addEventListener('click',()=>{state.splice(i,1);renderActiveEditStation();markDirty();});at.appendChild(rm);tr.append(idx,nt,pt,ut,at);tbody.appendChild(tr);});countEl.textContent=`${state.length} slot${state.length===1?'':'s'}`;}
function renderEditTabs(){const tabs=$('editStationTabs');tabs.innerHTML='';editData.stations.forEach((station,i)=>{const b=document.createElement('button');b.type='button';b.className='station-tab'+(i===activeEditStation?' active':'');const n=document.createElement('span');n.textContent=i+1;b.append(n,document.createTextNode(station.name||`Station ${i+1}`));b.addEventListener('click',()=>{activeEditStation=i;renderActiveEditStation();});tabs.appendChild(b);});}
function renderActiveEditStation(){const s=editData.stations[activeEditStation];$('stationName').value=s.name;$('editDayStationTitle').textContent=s.name;$('editNightStationTitle').textContent=s.name;renderEditTabs();renderShiftTable(s.shifts.day,$('editDayBody'),$('editDayCount'));renderShiftTable(s.shifts.night,$('editNightBody'),$('editNightCount'));}
function updateLockState(){const locked=isPastDate(loadedEditDate);$('editorArea').disabled=locked;$('saveBtn').disabled=locked;$('saveBottomBtn').disabled=locked;$('lockedBanner').style.display=locked?'block':'none';$('cloudDetail').textContent=locked?'This assignment is read-only because its date has finished.':'Changes save automatically after you stop typing.';}
function markDirty(){if(isPastDate(loadedEditDate))return;dirty=true;$('cloudStatus').textContent='Unsaved changes…';clearTimeout(saveTimer);saveTimer=setTimeout(()=>saveNow(true),APP_CONFIG.autoSaveDelayMs);}
async function saveNow(automatic=false){if(saving||!dirty||isPastDate(loadedEditDate))return;clearTimeout(saveTimer);saving=true;$('cloudStatus').textContent=automatic?'Auto-saving…':'Saving…';try{editData.unitName=$('editUnitName').value.trim();editData.assignmentDate=loadedEditDate;editData.date=loadedEditDate;editData.revision=await saveAssignment(editData);dirty=false;$('cloudStatus').textContent='Saved to Firestore';$('cloudDetail').textContent=`Saved ${new Date().toLocaleTimeString()}`;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),1800);}catch(err){console.error(err);$('cloudStatus').textContent='Save failed';$('cloudDetail').textContent=err.message;if(!automatic)alert(`Could not save: ${err.message}`);}finally{saving=false;}}
async function loadEditDate(dateId){clearTimeout(saveTimer);dirty=false;loadedEditDate=dateId;$('editDateField').value=dateId;$('cloudStatus').textContent='Loading assignment…';$('cloudDetail').textContent='Reading from Firestore.';const existing=await getAssignment(dateId);editData=existing?normalizeAssignmentData(existing,dateId):defaultAssignmentData(dateId);$('editUnitName').value=editData.unitName||'';activeEditStation=0;renderActiveEditStation();$('editUpdatedNote').textContent=editData.updatedAt?`Last updated ${formatTimestamp(editData.updatedAt)}`:'No assignment saved for this date yet';$('cloudStatus').textContent=existing?'Connected · assignment loaded':'Connected · new assignment';updateLockState();}
async function initEdit(){if(!['supervisor','admin'].includes(session.profile.role)){navigate('view');return;}try{await loadEditDate(loadedEditDate||todayDateId());}catch(err){console.error(err);$('cloudStatus').textContent='Could not load Firestore';$('cloudDetail').textContent=err.message;}}
$('stationName').addEventListener('input',()=>{const v=$('stationName').value.trimStart();editData.stations[activeEditStation].name=v||`Station ${activeEditStation+1}`;$('editDayStationTitle').textContent=editData.stations[activeEditStation].name;$('editNightStationTitle').textContent=editData.stations[activeEditStation].name;renderEditTabs();markDirty();});$('editUnitName').addEventListener('input',markDirty);$('dayAddBtn').addEventListener('click',()=>{editData.stations[activeEditStation].shifts.day.push(blankAssignment());renderActiveEditStation();markDirty();});$('nightAddBtn').addEventListener('click',()=>{editData.stations[activeEditStation].shifts.night.push(blankAssignment());renderActiveEditStation();markDirty();});$('saveBtn').addEventListener('click',()=>saveNow(false));$('saveBottomBtn').addEventListener('click',()=>saveNow(false));$('editDateField').addEventListener('change',async()=>{const next=$('editDateField').value;if(!next){$('editDateField').value=loadedEditDate;return;}if(dirty)await saveNow(false);await loadEditDate(next);});$('previewBtn').addEventListener('click',()=>{selectedViewDate=loadedEditDate;navigate('view');});
window.addEventListener('beforeunload',e=>{if(dirty){e.preventDefault();e.returnValue='';}});

// ADMIN
async function loadUsers(){if(session.profile.role!=='admin')return;const body=$('usersBody'),msg=$('adminMessage');body.innerHTML='';msg.textContent='Loading users…';try{const snap=await getDocs(collection(db,'users')),users=snap.docs.map(d=>({uid:d.id,...d.data()})).sort((a,b)=>(a.name||a.email||'').localeCompare(b.name||b.email||''));users.forEach(u=>{const tr=document.createElement('tr'),name=document.createElement('td'),email=document.createElement('td'),role=document.createElement('td'),updated=document.createElement('td');name.textContent=u.name||'—';email.textContent=u.email||'—';if(u.role==='admin'){const badge=document.createElement('span');badge.className='role-badge';badge.textContent='admin';role.appendChild(badge);}else{const select=document.createElement('select');select.className='role-select';['staff','supervisor'].forEach(r=>{const o=document.createElement('option');o.value=r;o.textContent=r[0].toUpperCase()+r.slice(1);o.selected=u.role===r;select.appendChild(o);});select.addEventListener('change',async()=>{select.disabled=true;msg.textContent=`Updating ${u.name||u.email}…`;try{await updateDoc(doc(db,'users',u.uid),{role:select.value,updatedAt:serverTimestamp(),roleAssignedBy:session.user.uid});msg.textContent='Role updated.';}catch(err){console.error(err);msg.textContent=`Could not update role: ${err.message}`;await loadUsers();}finally{select.disabled=false;}});role.appendChild(select);}updated.textContent=formatTimestamp(u.updatedAt)||'—';tr.append(name,email,role,updated);body.appendChild(tr);});msg.textContent=`${users.length} registered user${users.length===1?'':'s'}.`;}catch(err){console.error(err);msg.textContent=`Could not load users: ${err.message}`;}}
$('refreshUsersBtn').addEventListener('click',loadUsers);

onAuthStateChanged(auth,async user=>{$('loadingScreen').style.display='none';if(!user){session=null;if(viewUnsub){viewUnsub();viewUnsub=null;}$('appShell').classList.remove('active');$('authScreen').classList.add('active');showAuthTab('login');return;}try{const profile=await ensureUserProfile(user);session={user,profile};$('authScreen').classList.remove('active');$('appShell').classList.add('active');applyRoleUI();await navigate('home');}catch(err){console.error(err);$('authScreen').classList.add('active');$('appShell').classList.remove('active');setAuthMessage(`Signed in, but the user profile could not be loaded. Check Firestore and its security rules: ${err.message}`,true);}});
</script>
