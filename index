<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="light">
<title>Nursing Assignment Board</title>
<style>
/* ---------------------------------------------------------
   Nursing Assignment Board — visual identity
   Palette: clinical teal/ink on soft clinical white,
   amber accent reserved for "live" state and Night shift.
   Type: a firm grotesque for structure, a humane serif
   nowhere (kept purely functional — this is a working tool).
--------------------------------------------------------- */
:root{
  --ink:        #10262b;
  --teal-900:   #0d3b3e;
  --teal-700:   #14615f;
  --teal-500:   #1f8a82;
  --teal-100:   #e4f2f0;
  --paper:      #f6f8f7;
  --paper-2:    #ffffff;
  --line:       #cfe0dd;
  --amber:      #c97a2b;
  --amber-100:  #fbeee0;
  --red:        #b3452f;
  --shadow:     0 1px 2px rgba(13,59,62,0.06), 0 8px 24px -12px rgba(13,59,62,0.18);
  --radius:     10px;
}

*{ box-sizing: border-box; }

html,body{
  margin:0;
  padding:0;
  background:var(--paper);
  color:var(--ink);
  font-family: "Segoe UI", "IBM Plex Sans", -apple-system, Arial, sans-serif;
}

body{
  min-height:100vh;
}

.topbar{
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:16px;
  padding:14px 24px;
  background:var(--teal-900);
  color:var(--paper-2);
}

.topbar .brand{
  display:flex;
  align-items:baseline;
  gap:10px;
}

.topbar .brand .mark{
  font-weight:800;
  letter-spacing:0.04em;
  font-size:15px;
  color:var(--amber);
  border:1px solid rgba(255,255,255,0.25);
  padding:2px 8px;
  border-radius:999px;
}

.topbar h1{
  font-size:16px;
  font-weight:600;
  margin:0;
  letter-spacing:0.01em;
}

.topbar a.back{
  color:var(--paper-2);
  text-decoration:none;
  font-size:14px;
  opacity:0.85;
  border:1px solid rgba(255,255,255,0.3);
  padding:6px 12px;
  border-radius:8px;
}
.topbar a.back:hover{ opacity:1; background:rgba(255,255,255,0.08); }

.status-pill{
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-size:12px;
  padding:5px 10px;
  border-radius:999px;
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(255,255,255,0.2);
}
.status-dot{
  width:8px; height:8px; border-radius:50%;
  background:#7fd4a0;
  box-shadow:0 0 0 3px rgba(127,212,160,0.25);
}
.status-dot.off{ background:#e08b6f; box-shadow:0 0 0 3px rgba(224,139,111,0.25); }

/* ---------- Home ---------- */
.home-wrap{
  max-width:920px;
  margin:0 auto;
  padding:64px 24px;
}
.home-header{ text-align:center; margin-bottom:40px; }
.home-header .eyebrow{
  text-transform:uppercase;
  font-size:12px;
  letter-spacing:0.16em;
  color:var(--teal-700);
  font-weight:700;
}
.home-header h1{
  font-size:34px;
  margin:8px 0 6px;
  color:var(--teal-900);
}
.home-header p{
  color:#4a615f;
  max-width:520px;
  margin:0 auto;
  line-height:1.5;
}

.choice-grid{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
  margin-top:36px;
}
@media (max-width:640px){ .choice-grid{ grid-template-columns:1fr; } }

.choice-card{
  display:block;
  text-decoration:none;
  color:inherit;
  background:var(--paper-2);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:28px 24px;
  box-shadow:var(--shadow);
  transition:transform .15s ease, box-shadow .15s ease, border-color .15s ease;
  position:relative;
  overflow:hidden;
}
.choice-card:hover{
  transform:translateY(-3px);
  border-color:var(--teal-500);
}
.choice-card .num{
  font-size:12px;
  font-weight:800;
  letter-spacing:0.12em;
  color:var(--teal-500);
}
.choice-card h2{
  margin:10px 0 6px;
  font-size:21px;
  color:var(--teal-900);
}
.choice-card p{
  margin:0;
  color:#4a615f;
  font-size:14px;
  line-height:1.5;
}
.choice-card .go{
  margin-top:16px;
  display:inline-flex;
  align-items:center;
  gap:6px;
  font-size:13px;
  font-weight:700;
  color:var(--teal-700);
}
.choice-card.view .go{ color:var(--amber); }
.choice-card.view h2{ color:var(--amber); }

.home-footnote{
  margin-top:36px;
  text-align:center;
  font-size:12.5px;
  color:#6b8582;
}

/* ---------- Shift board ---------- */
.page-wrap{
  max-width:1100px;
  margin:0 auto;
  padding:24px;
}

.meta-row{
  display:flex;
  flex-wrap:wrap;
  gap:14px;
  align-items:flex-end;
  background:var(--paper-2);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:16px 18px;
  margin-bottom:20px;
  box-shadow:var(--shadow);
}
.meta-field{ display:flex; flex-direction:column; gap:6px; flex:1; min-width:180px; }
.meta-field label{ font-size:11.5px; text-transform:uppercase; letter-spacing:0.08em; color:var(--teal-700); font-weight:700; }
.meta-field input{
  border:1px solid var(--line);
  border-radius:8px;
  padding:9px 10px;
  font-size:14.5px;
  background:var(--paper);
  color:var(--ink);
}
.meta-field input:read-only{ background:var(--teal-100); color:var(--teal-900); }
.meta-field input:focus{ outline:2px solid var(--teal-500); outline-offset:1px; }

.meta-updated{
  font-size:12.5px;
  color:#5c7572;
  white-space:nowrap;
  padding-bottom:9px;
}

.shift-columns{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:20px;
}
@media (max-width:860px){ .shift-columns{ grid-template-columns:1fr; } }

.shift-panel{
  background:var(--paper-2);
  border:1px solid var(--line);
  border-radius:var(--radius);
  overflow:hidden;
  box-shadow:var(--shadow);
}
.shift-head{
  display:flex;
  align-items:center;
  justify-content:space-between;
  padding:14px 16px;
  color:#fff;
}
.shift-head.day{ background:var(--teal-700); }
.shift-head.night{ background:var(--ink); }
.shift-head h3{ margin:0; font-size:15px; letter-spacing:0.03em; }
.shift-head span.hours{ font-size:12px; opacity:0.85; }

table.assign-table{
  width:100%;
  border-collapse:collapse;
}
table.assign-table thead th{
  text-align:left;
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:0.06em;
  color:var(--teal-700);
  padding:8px 10px;
  border-bottom:1px solid var(--line);
  background:var(--teal-100);
}
table.assign-table thead th.col-idx{ width:34px; }
table.assign-table thead th.col-nurse{ width:38%; }

table.assign-table td{
  padding:6px 8px;
  border-bottom:1px solid var(--line);
  vertical-align:middle;
}
table.assign-table tr:last-child td{ border-bottom:none; }
table.assign-table td.idx{
  color:#7d938f;
  font-size:12.5px;
  font-weight:700;
  text-align:center;
}

table.assign-table input[type="text"]{
  width:100%;
  border:1px solid transparent;
  background:transparent;
  padding:7px 8px;
  border-radius:6px;
  font-size:14px;
  color:var(--ink);
}
table.assign-table input[type="text"]:hover{ background:var(--paper); }
table.assign-table input[type="text"]:focus{
  outline:none;
  border-color:var(--teal-500);
  background:#fff;
  box-shadow:0 0 0 3px rgba(31,138,130,0.14);
}

/* read-only view mode */
.view-mode table.assign-table input[type="text"]{
  pointer-events:none;
  background:transparent;
}
.view-mode td.idx{ color:#9fb2af; }
.cell-empty{ color:#a9bdba; font-style:italic; }

/* actions */
.actions-row{
  display:flex;
  gap:12px;
  justify-content:flex-end;
  margin-top:20px;
}
button.btn, a.btn{
  font-family:inherit;
  font-size:14.5px;
  font-weight:700;
  padding:11px 20px;
  border-radius:9px;
  border:1px solid transparent;
  cursor:pointer;
  text-decoration:none;
  display:inline-flex;
  align-items:center;
  gap:8px;
}
.btn-primary{ background:var(--teal-700); color:#fff; }
.btn-primary:hover{ background:var(--teal-900); }
.btn-ghost{ background:transparent; color:var(--teal-700); border-color:var(--line); }
.btn-ghost:hover{ background:var(--teal-100); }

.save-toast{
  position:fixed;
  bottom:22px;
  left:50%;
  transform:translateX(-50%) translateY(12px);
  background:var(--ink);
  color:#fff;
  padding:10px 18px;
  border-radius:999px;
  font-size:13.5px;
  opacity:0;
  pointer-events:none;
  transition:opacity .2s ease, transform .2s ease;
  box-shadow:var(--shadow);
}
.save-toast.show{ opacity:1; transform:translateX(-50%) translateY(0); }

.legend-note{
  margin-top:14px;
  font-size:12.5px;
  color:#6b8582;
  text-align:right;
}

/* ---------- File connection panel ---------- */
.connect-panel{
  background:var(--paper-2);
  border:1px solid var(--line);
  border-radius:var(--radius);
  padding:18px;
  margin-bottom:20px;
  box-shadow:var(--shadow);
}
.connect-panel .connect-row{
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}
.connect-panel .file-name{
  font-size:13.5px;
  color:var(--teal-900);
  font-weight:700;
  background:var(--teal-100);
  padding:6px 12px;
  border-radius:999px;
}
.connect-panel .file-name.none{
  color:#8a5a3a;
  background:var(--amber-100);
}
.connect-panel p.hint{
  margin:10px 0 0;
  font-size:13px;
  color:#5c7572;
  line-height:1.5;
}

.support-banner{
  background:var(--amber-100);
  border:1px solid #e7c79a;
  color:#7a4a1f;
  border-radius:var(--radius);
  padding:14px 16px;
  margin-bottom:20px;
  font-size:13.5px;
  line-height:1.5;
}
.support-banner strong{ color:#5c3512; }

/* ---------- Dynamic slot controls ---------- */
table.assign-table th.col-action{ width:38px; }
table.assign-table td.action-cell{ text-align:center; padding:4px; }
.row-remove-btn{
  width:24px; height:24px;
  border-radius:6px;
  border:1px solid var(--line);
  background:transparent;
  color:var(--red);
  font-size:15px;
  line-height:1;
  cursor:pointer;
  display:inline-flex;
  align-items:center;
  justify-content:center;
}
.row-remove-btn:hover{ background:#fbe9e5; border-color:var(--red); }
.row-remove-btn:disabled{
  opacity:0.3;
  cursor:not-allowed;
}
.shift-foot{
  padding:10px 12px;
  border-top:1px solid var(--line);
  background:var(--paper);
}
.add-slot-btn{
  width:100%;
  border:1px dashed var(--teal-500);
  background:transparent;
  color:var(--teal-700);
  font-weight:700;
  font-size:13.5px;
  padding:9px;
  border-radius:8px;
  cursor:pointer;
}
.add-slot-btn:hover{ background:var(--teal-100); }

/* ---------- Unit assignment dropdown (edit page) ---------- */
table.assign-table select.unit-select{
  width:100%;
  border:1px solid var(--line);
  background:#fff;
  padding:7px 8px;
  border-radius:6px;
  font-size:13.5px;
  color:var(--ink);
  font-family:inherit;
}
table.assign-table select.unit-select:focus{
  outline:none;
  border-color:var(--teal-500);
  box-shadow:0 0 0 3px rgba(31,138,130,0.14);
}
table.assign-table th.col-unit{ width:34%; }
table.assign-table th.col-patient{ width:26%; }

/* ---------- Grid preview (view page) ---------- */
.shift-grid{
  display:grid;
  grid-template-columns:repeat(auto-fill, minmax(190px, 1fr));
  gap:14px;
  padding:16px;
}
.assign-card{
  position:relative;
  border-radius:12px;
  overflow:hidden;
  min-height:132px;
  padding:14px;
  color:#fff;
  display:flex;
  flex-direction:column;
  justify-content:flex-end;
  box-shadow:0 4px 14px -6px rgba(13,59,62,0.3);
}
.assign-card .card-icon{
  position:absolute;
  top:-14px;
  right:-10px;
  font-size:78px;
  opacity:0.22;
  line-height:1;
  transform:rotate(8deg);
}
.assign-card .card-slot{
  position:absolute;
  top:10px;
  left:10px;
  font-size:11px;
  font-weight:800;
  background:rgba(255,255,255,0.22);
  padding:2px 8px;
  border-radius:999px;
  letter-spacing:0.04em;
}
.assign-card .card-unit{
  font-size:12px;
  text-transform:uppercase;
  letter-spacing:0.05em;
  opacity:0.9;
  font-weight:700;
  margin-bottom:2px;
}
.assign-card .card-nurse{
  font-size:16px;
  font-weight:800;
  line-height:1.25;
}
.assign-card .card-patient{
  font-size:16px;
  font-weight:800;
  line-height:1.25;
  margin-top:4px;
  padding-top:6px;
  border-top:1px solid rgba(255,255,255,0.35);
}
.assign-card.unassigned .card-patient{
  border-top-color:var(--line);
  font-size:13.5px;
  font-weight:600;
  color:#7d938f;
}
.assign-card.unassigned{
  color:#7d938f;
  background:var(--paper) !important;
  border:1px dashed var(--line);
  box-shadow:none;
}
.assign-card.unassigned .card-nurse{
  font-weight:600;
  font-size:13.5px;
  color:#9fb2af;
}
.assign-card.unassigned .card-icon{ opacity:0.12; }

/* ---------- Four-station workflow ---------- */
.board-wide{ max-width:1500px; }
.section-kicker{ font-size:11px; text-transform:uppercase; letter-spacing:.09em; color:var(--teal-700); font-weight:800; margin-bottom:4px; }
.station-editor-shell{ background:var(--paper-2); border:1px solid var(--line); border-radius:var(--radius); padding:16px; margin-bottom:18px; box-shadow:var(--shadow); }
.station-tabs,.station-screen-tabs{ display:flex; gap:8px; flex-wrap:wrap; }
.station-tab,.station-screen-tab{ border:1px solid var(--line); background:#fff; color:var(--teal-900); border-radius:9px; padding:9px 13px; font:700 13.5px inherit; cursor:pointer; }
.station-tab span{ display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px; margin-right:7px; border-radius:999px; background:var(--teal-100); }
.station-tab.active,.station-screen-tab.active{ background:var(--teal-700); color:#fff; border-color:var(--teal-700); }
.station-tab.active span{ background:rgba(255,255,255,.2); }
.station-name-row{ display:flex; align-items:flex-end; gap:18px; margin-top:14px; flex-wrap:wrap; }
.station-name-field{ min-width:260px; flex:0 1 360px; }
.station-help{ flex:1; min-width:260px; color:#5c7572; font-size:13px; line-height:1.45; padding-bottom:7px; }

/* Multi-unit picker */
.unit-picker{ position:relative; width:100%; }
.unit-picker summary{ list-style:none; cursor:pointer; border:1px solid var(--line); background:#fff; padding:7px 28px 7px 8px; border-radius:6px; font-size:13px; color:var(--ink); position:relative; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.unit-picker summary::-webkit-details-marker{ display:none; }
.unit-picker summary::after{ content:'▾'; position:absolute; right:9px; top:7px; color:var(--teal-700); }
.unit-picker[open] summary{ border-color:var(--teal-500); box-shadow:0 0 0 3px rgba(31,138,130,.12); }
.unit-picker-menu{ position:absolute; z-index:20; top:calc(100% + 5px); left:0; min-width:330px; max-width:430px; max-height:360px; overflow-y:auto; background:#fff; border:1px solid var(--line); border-radius:9px; box-shadow:0 12px 28px rgba(13,59,62,.18); padding:7px; }
.unit-picker-menu label{ display:flex; align-items:center; gap:9px; padding:8px 9px; border-radius:6px; cursor:pointer; font-size:12.5px; line-height:1.3; }
.unit-picker-menu label:hover{ background:var(--teal-100); }
.unit-picker-menu input{ margin:0; accent-color:var(--teal-700); flex:0 0 auto; }
.unit-option-text{ min-width:0; font-weight:750; color:var(--ink); white-space:normal; }

/* Shared staff overview */
.staffing-overview{ margin:4px 0 20px; }
.overview-head,.station-display-control{ display:flex; justify-content:space-between; align-items:flex-end; gap:16px; margin-bottom:11px; flex-wrap:wrap; }
.overview-head h2,.station-display-control h2{ margin:0; font-size:21px; color:var(--ink); }
.overview-note{ font-size:12.5px; color:#64807c; }
.station-overview-grid{ display:grid; grid-template-columns:repeat(4,minmax(210px,1fr)); gap:12px; }
.station-overview-card{ background:var(--paper-2); border:1px solid var(--line); border-radius:12px; padding:13px; box-shadow:var(--shadow); }
.station-overview-card.current{ border:2px solid var(--teal-500); padding:12px; }
.station-overview-card-head{ display:flex; align-items:center; gap:8px; margin-bottom:10px; }
.station-overview-card-head h3{ margin:0; font-size:15px; color:var(--ink); }
.station-number{ display:inline-flex; align-items:center; justify-content:center; min-width:27px; height:27px; border-radius:8px; background:var(--teal-700); color:#fff; font-size:12px; font-weight:800; }
.staff-shift-row{ display:grid; grid-template-columns:42px 1fr; gap:7px; align-items:start; padding:6px 0; border-top:1px solid var(--line); }
.staff-shift-row b{ font-size:11px; color:var(--teal-700); text-transform:uppercase; letter-spacing:.04em; padding-top:4px; }
.staff-chips{ display:flex; flex-wrap:wrap; gap:5px; }
.staff-chip{ background:var(--teal-100); color:var(--teal-900); padding:3px 7px; border-radius:999px; font-size:11.5px; font-weight:700; }
.staff-empty{ color:#94a8a5; font-size:11.5px; font-style:italic; padding-top:3px; }
.station-display-control{ margin-top:22px; }
.station-detail-columns{ align-items:start; }

/* Multiple duty badges inside assignment cards */
.assign-card{ justify-content:flex-start; min-height:154px; }
.assign-card .card-nurse{ margin-top:28px; }
.card-units{ display:flex; flex-wrap:wrap; gap:5px; margin-top:auto; padding-top:9px; }
.card-unit-badge{ display:inline-flex; align-items:center; gap:3px; background:rgba(255,255,255,.20); border:1px solid rgba(255,255,255,.30); padding:4px 7px; border-radius:999px; font-size:10.5px; font-weight:750; line-height:1.15; }
.card-unit-empty{ margin-top:auto; padding-top:9px; opacity:.75; }
.assign-card.unassigned .card-unit-badge{ background:#eef5f4; border-color:var(--line); color:#657d79; }

.station-quick-links{ margin-top:20px; display:flex; justify-content:center; align-items:center; flex-wrap:wrap; gap:8px; font-size:13px; color:#64807c; }
.station-quick-links a{ color:var(--teal-700); text-decoration:none; font-weight:800; border:1px solid var(--line); border-radius:999px; padding:6px 10px; background:#fff; }
.station-quick-links a:hover{ background:var(--teal-100); }

@media (max-width:1100px){ .station-overview-grid{ grid-template-columns:repeat(2,minmax(210px,1fr)); } }
@media (max-width:620px){ .station-overview-grid{ grid-template-columns:1fr; } .unit-picker-menu{ min-width:280px; max-width:88vw; } .board-meta{ grid-template-columns:1fr; } }
body:not(.view-mode) .shift-panel{ overflow:visible; }
body:not(.view-mode) .shift-head{ border-radius:var(--radius) var(--radius) 0 0; }
body:not(.view-mode) .shift-foot{ border-radius:0 0 var(--radius) var(--radius); }

/* ---- Firebase / authentication additions ---- */
.user-bar{display:flex;align-items:center;gap:9px;flex-wrap:wrap;justify-content:flex-end;color:#e9f5f3;font-size:13px}
.role-badge{display:inline-flex;align-items:center;padding:4px 8px;border-radius:999px;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.2);font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.06em}
.btn-small{padding:7px 10px!important;font-size:12px!important}
.auth-page{min-height:100vh;background:linear-gradient(135deg,var(--teal-900),var(--teal-700));display:grid;place-items:center;padding:24px}
.auth-shell{width:min(470px,100%)}
.auth-card{background:#fff;border-radius:18px;padding:30px;box-shadow:0 22px 60px rgba(0,0,0,.25)}
.auth-brand{display:flex;align-items:center;gap:12px;margin-bottom:24px}.auth-brand .mark{background:var(--teal-700);color:#fff;border-radius:8px;padding:10px;font-weight:900}.auth-brand h1{font-size:18px;margin:2px 0 0;color:var(--ink)}
.auth-card h2{font-size:28px;margin:0 0 6px;color:var(--ink)}.auth-copy{color:var(--muted);font-size:14px;line-height:1.55;margin:0 0 22px}
