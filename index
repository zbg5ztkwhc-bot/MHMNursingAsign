<div id="loadingScreen" class="auth-page-wrap"><section class="auth-card"><div class="auth-brand"><span class="mark">NAB</span><div><div class="section-kicker">Firebase cloud board</div><h1>Nursing Assignment Board</h1></div></div><p class="auth-copy">Connecting securely…</p></section></div>

